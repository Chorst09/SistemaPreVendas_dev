{
  "name": "sistema-prevendas-backend",
  "version": "1.0.0",
  "description": "Backend API para Sistema de Prevendas",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "zod": "^3.24.2",
    "uuid": "^13.0.0",
    "@genkit-ai/googleai": "^1.14.1",
    "genkit": "^1.14.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/cors": "^2.8.17",
    "typescript": "^5",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4",
    "@testing-library/jest-dom": "^6.8.0"
  }
}
